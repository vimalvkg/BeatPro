<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_beatpro_payment_wizard_form" model="ir.ui.view">
        <field name="name">beatpro.payment.wizard.form</field>
        <field name="model">beatpro.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Collect Payment">
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="amount_due"/>
                        <field name="method" widget="radio" options="{'horizontal': true}"/>
                        <field name="amount" required="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="cheque_number" invisible="method != 'cheque'" required="method == 'cheque'"/>
                        <field name="cheque_date" invisible="method != 'cheque'"/>
                        <field name="upi_reference" invisible="method != 'upi'"/>
                        <field name="visit_id" readonly="1" invisible="not visit_id"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0" decoration-danger="overdue">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="name"/>
                        <field name="due_date"/>
                        <field name="amount_due" sum="Total"/>
                        <field name="overdue" column_invisible="1"/>
                        <field name="invoice_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <p class="text-muted">Turn on the invoices this payment settles. With none selected, the payment stays on the customer's account as an advance.</p>
                <footer>
                    <button name="action_confirm" type="object" string="Record Payment" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_beatpro_payment_wizard" model="ir.actions.act_window">
        <field name="name">Collect Payment</field>
        <field name="res_model">beatpro.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
