<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_beatpro_payment_wizard_form" model="ir.ui.view">
        <field name="name">beatpro.payment.wizard.form</field>
        <field name="model">beatpro.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Collect Payment" class="o_beatpro_payment_form">
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="amount_due" invisible="1"/>
                <div class="bp-amount-box">
                    <label for="amount" string="Amount collected" class="text-muted fw-bold"/>
                    <field name="amount" required="1" nolabel="1"/>
                    <div class="bp-hint"><field name="amount_hint" nolabel="1"/></div>
                </div>
                <div class="bp-label">Paid by</div>
                <div class="bp-methods">
                    <field name="method" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                </div>
                <group>
                    <group>
                        <field name="method_reference" invisible="1"/>
                        <field name="reference" invisible="method_reference != 'reference'" placeholder="Optional"/>
                        <field name="cheque_number" invisible="method_reference != 'cheque'" required="method_reference == 'cheque'"/>
                        <field name="cheque_date" invisible="method_reference != 'cheque'"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="visit_id" readonly="1" invisible="not visit_id"/>
                    </group>
                </group>
                <div class="bp-label">Settles invoices</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0" decoration-danger="overdue">
                        <field name="selected" widget="boolean_toggle" string="Pay"/>
                        <field name="name"/>
                        <field name="due_date"/>
                        <field name="amount_due" sum="Total"/>
                        <field name="overdue" column_invisible="1"/>
                        <field name="invoice_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <p class="text-muted small mb-0">With no invoice selected, the payment stays on the customer's account as an advance.</p>
                <field name="online_enabled" invisible="1"/>
                <div class="bp-online mt-3" invisible="not online_link">
                    <div class="bp-label">Pay online</div>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <field name="online_qr" widget="image" readonly="1" nolabel="1" options="{'size': [180, 180]}"/>
                        <div class="flex-grow-1" style="min-width: 0">
                            <div class="fw-bold"><field name="online_invoice" nolabel="1"/></div>
                            <div class="text-muted small mb-2">The customer scans the code or opens the link to pay. The invoice is marked paid when the payment comes through.</div>
                            <field name="online_link" widget="CopyClipboardChar" nolabel="1"/>
                        </div>
                    </div>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Record payment" class="btn-primary" data-hotkey="q"/>
                    <button name="action_payment_link" type="object" string="Pay online" icon="fa-qrcode"
                            invisible="not online_enabled" class="btn-secondary"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_beatpro_payment_wizard" model="ir.actions.act_window">
        <field name="name">Collect Payment</field>
        <field name="res_model">beatpro.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
