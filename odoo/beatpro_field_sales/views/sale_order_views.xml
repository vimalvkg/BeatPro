<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_beatpro" model="ir.ui.view">
        <field name="name">sale.order.form.beatpro</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_beatpro_request_approval" type="object" string="Request Approval"
                        invisible="state not in ('draft', 'sent') or beatpro_approval_state"
                        groups="beatpro_field_sales.group_beatpro_rep"/>
                <button name="action_beatpro_approve" type="object" string="Approve Discount" class="btn-primary"
                        invisible="beatpro_approval_state != 'waiting'"
                        groups="beatpro_field_sales.group_beatpro_supervisor"/>
                <button name="action_beatpro_apply_schemes" type="object" string="Apply Schemes"
                        invisible="state not in ('draft', 'sent')"/>
                <field name="beatpro_van_invoice_ids" invisible="1"/>
                <button name="action_beatpro_print_slip" type="object" string="Print Invoice Slip"
                        icon="fa-print" invisible="not beatpro_van_invoice_ids"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="beatpro_approval_state != 'waiting'">
                    This order's discount is above the rep's limit. A supervisor must approve it.
                </div>
                <field name="beatpro_overdue_warning" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="not beatpro_overdue_warning">
                    <field name="beatpro_overdue_warning" readonly="1"/>
                </div>
            </xpath>
            <group name="sales_person" position="inside">
                <field name="beatpro_visit_id" readonly="1" invisible="not beatpro_visit_id"/>
                <field name="beatpro_approval_state" readonly="1" invisible="not beatpro_approval_state"/>
                <field name="beatpro_saved" invisible="not beatpro_saved"/>
            </group>
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="beatpro_scheme_id" optional="show" readonly="1"/>
                <field name="beatpro_free" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_beatpro" model="ir.ui.view">
        <field name="name">sale.order.search.beatpro</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Waiting for Discount Approval" name="beatpro_waiting_approval"
                        domain="[('beatpro_approval_state', '=', 'waiting')]"/>
                <filter string="From Field Visits" name="beatpro_from_visits"
                        domain="[('beatpro_visit_id', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="action_beatpro_orders" model="ir.actions.act_window">
        <field name="name">Field Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">['|', ('beatpro_visit_id', '!=', False), ('mobile_uuid', '!=', False)]</field>
        <field name="context">{'search_default_my_sale_orders_filter': 1}</field>
    </record>

    <record id="action_beatpro_orders_approval" model="ir.actions.act_window">
        <field name="name">Discount Approvals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('beatpro_approval_state', '=', 'waiting')]</field>
    </record>
</odoo>
