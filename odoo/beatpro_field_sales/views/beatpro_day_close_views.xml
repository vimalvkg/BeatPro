<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_beatpro_day_close_list" model="ir.ui.view">
        <field name="name">beatpro.day.close.list</field>
        <field name="model">beatpro.day.close</field>
        <field name="arch" type="xml">
            <list string="Day-End Closes">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="visit_count" sum="Total"/>
                <field name="order_count" sum="Total"/>
                <field name="order_amount" sum="Total"/>
                <field name="total_collected" sum="Total"/>
                <field name="distance_km" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_beatpro_day_close_form" model="ir.ui.view">
        <field name="name">beatpro.day.close.form</field>
        <field name="model">beatpro.day.close</field>
        <field name="arch" type="xml">
            <form string="Close the day" class="o_beatpro_day_close_form">
                <header>
                    <button name="action_close" type="object" string="Close day and send to supervisor" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_refresh" type="object" string="Refresh totals" invisible="state != 'draft'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'closed'" groups="beatpro_field_sales.group_beatpro_supervisor"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Close the day</h1>
                        <div class="d-flex flex-wrap gap-3 text-muted">
                            <field name="user_id" readonly="state == 'closed'" options="{'no_open': True}"/>
                            <field name="date" readonly="state == 'closed'"/>
                        </div>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>

                    <div class="bp-handover">
                        <div class="bp-handover-label">Hand in to the office</div>
                        <div class="bp-handover-value"><field name="handover_amount"/></div>
                        <div class="bp-handover-split">
                            <div><span class="bp-split-label d-block">Cash</span><field name="cash_amount"/></div>
                            <div><span class="bp-split-label d-block">Cheque</span><field name="cheque_amount"/>
                                <span class="bp-split-sub d-block"><field name="cheque_count" class="d-inline" style="font-size: 12px; font-weight: 700; color: #C9D8E8"/> cheques</span></div>
                            <div><span class="bp-split-label d-block">UPI</span><field name="upi_amount"/>
                                <span class="bp-split-sub d-block">already in the bank</span></div>
                        </div>
                    </div>

                    <div class="bp-day-stats">
                        <div><span class="bp-stat-label">Visits done</span><field name="visit_count"/></div>
                        <div><span class="bp-stat-label">Orders</span><field name="order_count"/></div>
                        <div><span class="bp-stat-label">Order value</span><field name="order_amount"/></div>
                    </div>

                    <notebook>
                        <page string="Visits" name="visits">
                            <field name="visit_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" decoration-warning="result in ('no_order', 'closed')">
                                    <field name="partner_id"/>
                                    <field name="check_in" widget="datetime" options="{'show_date': False}" string="Time"/>
                                    <field name="result"/>
                                    <field name="no_order_reason" optional="show"/>
                                    <field name="amount_ordered" sum="Total"/>
                                    <field name="amount_collected" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Distance and note" name="details">
                            <group>
                                <group>
                                    <field name="distance_km" readonly="state == 'closed'"/>
                                    <field name="total_collected"/>
                                </group>
                            </group>
                            <field name="note" placeholder="Anything the supervisor should know about today..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_beatpro_day_close_search" model="ir.ui.view">
        <field name="name">beatpro.day.close.search</field>
        <field name="model">beatpro.day.close</field>
        <field name="arch" type="xml">
            <search string="Day-End Closes">
                <field name="user_id"/>
                <filter string="My Days" name="my_days" domain="[('user_id', '=', uid)]"/>
                <filter string="Open" name="open" domain="[('state', '=', 'draft')]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Sales Rep" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_beatpro_day_close" model="ir.actions.act_window">
        <field name="name">Day-End Closes</field>
        <field name="res_model">beatpro.day.close</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No days closed yet</p>
            <p>Reps close their day in the BeatPro app. Each close totals the day's visits, orders and collections.</p>
        </field>
    </record>
</odoo>
