<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_beatpro" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.beatpro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="BeatPro" string="BeatPro" name="beatpro_field_sales"
                     groups="beatpro_field_sales.group_beatpro_supervisor">
                    <block title="Field Collections" name="beatpro_collections">
                        <setting string="Journals" help="Where cash, cheque and UPI payments collected by reps are recorded">
                            <div class="row mt-2">
                                <label for="beatpro_cash_journal_id" string="Cash" class="col-lg-4 o_light_label"/>
                                <field name="beatpro_cash_journal_id" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label for="beatpro_bank_journal_id" string="Cheque and UPI" class="col-lg-4 o_light_label"/>
                                <field name="beatpro_bank_journal_id" class="col-lg-8"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Reps" name="beatpro_reps">
                        <setting string="Mobile app access" help="Reps sign in to the BeatPro app with their Odoo login and an API key from their profile (Security tab). Set each rep's discount limit on the BeatPro tab of their user."/>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_beatpro_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'beatpro_field_sales', 'bin_size': False}</field>
    </record>
</odoo>
