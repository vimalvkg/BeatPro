<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_beatpro" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.beatpro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="BeatPro" string="BeatPro" name="beatpro_field_sales"
                     groups="beatpro_field_sales.group_beatpro_supervisor">
                    <block title="Field Collections" name="beatpro_collections">
                        <setting string="Payment methods for reps" help="Choose which incoming payment methods of your cash and bank journals reps can record, what they're called, and whether reps enter a reference or cheque details.">
                            <button name="%(beatpro_field_sales.action_beatpro_payment_methods)d" type="action" string="Payment Methods" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                        <setting string="Online payments" help="Reps can show customers a QR code or share a link to pay an invoice online with the payment providers enabled here.">
                            <button name="%(payment.action_payment_provider)d" type="action" string="Payment Providers" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="Reps" name="beatpro_reps">
                        <setting string="Mobile app access" help="Reps sign in to the BeatPro app with their Odoo login and an API key from their profile (Security tab). Set each rep's discount limit on the BeatPro tab of their user."/>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_beatpro_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'beatpro_field_sales', 'bin_size': False}</field>
    </record>
</odoo>
